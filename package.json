{
    "name": "@hodfords/typeorm-helper",
    "version": "11.2.1",
    "description": "Simplifies TypeORM usage in NestJS apps",
    "license": "MIT",
    "readmeFilename": "README.md",
    "author": {
        "name": "Dung Nguyen Tien",
        "email": "nguyentiendung.dev@gmail.com"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/hodfords-solutions/typeorm-helper"
    },
    "bugs": {
        "url": "https://github.com/hodfords-solutions/typeorm-helper/issues"
    },
    "tags": [
        "orm",
        "typescript",
        "typescript-orm",
        "typeorm-sample",
        "typeorm-example"
    ],
    "peerDependencies": {
        "typeorm": "*",
        "@nestjs/common": "*",
        "@nestjs/core": "*",
        "@nestjs/typeorm": "*",
        "@types/jest": "*",
        "@types/node": "*",
        "pg": "*",
        "lodash": "*"
    },
    "devDependencies": {
        "@hodfords/nestjs-eslint-config": "11.0.2",
        "@hodfords/nestjs-prettier-config": "11.0.1",
        "@nestjs/common": "11.1.27",
        "@nestjs/core": "11.1.27",
        "@nestjs/typeorm": "11.0.2",
        "@types/jest": "30.0.0",
        "@types/node": "25.2.0",
        "cspell": "9.6.3",
        "eslint": "9.39.2",
        "husky": "9.1.7",
        "is-ci": "4.1.0",
        "jest": "30.2.0",
        "lint-staged": "16.2.7",
        "lodash": "4.18.1",
        "pg": "8.18.0",
        "prettier": "3.8.1",
        "reflect-metadata": "0.2.2",
        "rimraf": "6.1.2",
        "ts-jest": "29.4.6",
        "ts-node": "10.9.2",
        "typeorm": "1.0.0",
        "typescript": "5.9.3"
    },
    "scripts": {
        "prebuild": "rimraf dist",
        "build": "tsc",
        "postbuild": "cp package.json dist/lib && cp README.md dist/lib && cp .npmrc dist/lib",
        "deploy": "npm run build && npm publish dist",
        "typeorm": "./node_modules/.bin/typeorm ",
        "format": "prettier --write \"**/*.ts\"",
        "check": "prettier --check \"**/*.ts\"",
        "test": "jest --passWithNoTests  --testTimeout=450000 --runInBand",
        "cspell": "cspell",
        "prepare": "is-ci || husky",
        "lint": "eslint \"lib/**/*.ts\" \"sample/**/*.ts\" --fix --max-warnings 0",
        "lint-staged": "lint-staged"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "modulePathIgnorePatterns": [
            "<rootDir>/dist/"
        ],
        "rootDir": ".",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            ".+\\.(t|j)s$": "ts-jest"
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node",
        "moduleNameMapper": {
            "@hodfords/typeorm-helper(|/.*)$": "<rootDir>/lib/$1"
        }
    }
}
