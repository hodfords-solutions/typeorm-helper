{
    "name": "@hodfords/typeorm-helper",
    "version": "12.2.0",
    "packageManager": "pnpm@12.0.0",
    "description": "Simplifies TypeORM usage in NestJS apps",
    "license": "MIT",
    "readmeFilename": "README.md",
    "type": "module",
    "main": "./index.js",
    "types": "./index.d.ts",
    "exports": {
        ".": {
            "types": "./index.d.ts",
            "import": "./index.js",
            "default": "./index.js"
        },
        "./package.json": "./package.json"
    },
    "engines": {
        "node": ">=20.19.0"
    },
    "author": {
        "name": "Dung Nguyen Tien",
        "email": "nguyentiendung.dev@gmail.com"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/hodfords-solutions/typeorm-helper"
    },
    "bugs": {
        "url": "https://github.com/hodfords-solutions/typeorm-helper/issues"
    },
    "tags": [
        "orm",
        "typescript",
        "typescript-orm",
        "typeorm-sample",
        "typeorm-example"
    ],
    "peerDependencies": {
        "@nestjs/common": ">=12.0.0",
        "@nestjs/core": ">=12.0.0",
        "@nestjs/typeorm": "*",
        "@types/node": "*",
        "pg": "*",
        "typeorm": ">=1.0.0"
    },
    "devDependencies": {
        "@hodfords/nestjs-eslint-config": "11.0.4",
        "@hodfords/nestjs-prettier-config": "11.0.2",
        "@nestjs/common": "12.0.1",
        "@nestjs/core": "12.0.1",
        "@nestjs/testing": "^12.0.1",
        "@nestjs/typeorm": "12.0.1",
        "@swc/core": "^1.16.1",
        "@types/node": "26.4.0",
        "cspell": "10.1.1",
        "eslint": "10.9.1",
        "husky": "9.1.7",
        "is-ci": "4.1.0",
        "lint-staged": "17.4.1",
        "pg": "8.23.0",
        "prettier": "3.9.6",
        "reflect-metadata": "0.2.2",
        "rimraf": "6.1.3",
        "typeorm": "1.1.0",
        "typescript": "6.0.3",
        "unplugin-swc": "^1.5.11",
        "vitest": "^4.1.11"
    },
    "scripts": {
        "prebuild": "rimraf dist *.tsbuildinfo",
        "build": "tsc -p tsconfig.build.json",
        "postbuild": "cp package.json dist && cp README.md dist && cp .npmrc dist",
        "deploy": "pnpm run build && pnpm publish dist",
        "typeorm": "./node_modules/.bin/typeorm ",
        "format": "prettier --write \"**/*.ts\"",
        "check": "prettier --check \"**/*.ts\"",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:cov": "vitest run --coverage",
        "cspell": "cspell",
        "prepare": "is-ci || husky",
        "lint": "eslint \"lib/**/*.ts\" \"sample/**/*.ts\" --fix --max-warnings 0",
        "lint-staged": "lint-staged"
    },
    "dependencies": {
        "es-toolkit": "1.52.0"
    }
}
